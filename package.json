{
  "name": "coffee-cherry-helpdesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3002",
    "build": "nuxt build",
    "preview": "nuxt preview --host 0.0.0.0 --port 3002",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,scss,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@pinia/nuxt": "0.9.0",
    "@vueuse/core": "^12.7.0",
    "@vueuse/nuxt": "^12.7.0",
    "nuxt": "3.15.4",
    "pinia": "2.3.1",
    "socket.io-client": "^4.8.3",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.5",
    "@nuxtjs/tailwindcss": "6.13.1",
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "happy-dom": "^16.7.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "sass": "1.83.4",
    "typescript": "5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
